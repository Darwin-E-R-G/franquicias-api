# Local execution using the OLD Render PostgreSQL database.
# Copy to .env and replace placeholders (never commit .env).
# Use the EXTERNAL connection details on the old database's Render dashboard.
LOCAL_POSTGRES_JDBC_URL=jdbc:postgresql://OLD_RENDER_POSTGRES_HOST:5432/OLD_DATABASE_NAME?sslmode=require
LOCAL_POSTGRES_USER=OLD_DATABASE_USER
LOCAL_POSTGRES_PASSWORD=REPLACE_WITH_ROTATED_PASSWORD
